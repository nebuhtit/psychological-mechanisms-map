<https://pmm.local/id/measurement:avoidance-selection-rate> a ns1:Measurement ;
    ns1:curation_status "accepted" ;
    ns1:definition "Proportion or count of eligible trials on which the predefined avoidance action is selected." ;
    ns1:label "Avoidance-action selection rate" ;
    ns1:measurement_kind "behavioral_task" ;
    ns1:method "Report the response definition, eligible trials, denominator, and contingency assigned to each option." ;
    ns1:ontological_level "type" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
