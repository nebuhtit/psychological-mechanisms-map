<https://pmm.local/id/contingency:avoidance-response-outcome> a ns1:Contingency ;
    ns1:antecedent_ids <https://pmm.local/id/context:controlled-instrumental-avoidance> ;
    ns1:boundary_notes "A programmed contingency is part of the experimental design, not by itself evidence that learning occurred." ;
    ns1:comparator "Alternative response, no response, or noncontingent/yoked consequence schedule." ;
