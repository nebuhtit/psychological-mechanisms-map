    ns1:result_type "continuous" ;
    ns1:target_ids <https://pmm.local/id/behavior:avoidance-response> ;
    ns1:unit_of_analysis "behavior" .

<https://pmm.local/id/mechanism:negative-reinforcement> a ns1:Mechanism ;
    ns1:boundary_notes "Negative denotes removal or reduction, not harmfulness.",
        "Outcome omission, relief, safety signaling, action-outcome knowledge, and habit must remain distinguishable candidate processes." ;
    ns1:curation_status "accepted" ;
    ns1:definition "Instrumental learning process in which a response-contingent removal, reduction, or prevention of an aversive consequence increases later probability or rate of the response under relevant conditions." ;
    ns1:label "Negative reinforcement learning" ;
    ns1:mechanism_kind "learning" ;
    ns1:ontological_level "type" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:realization_conditions "Later probability or rate of the target response increases under relevant conditions.",
        "Temporal adjacency without contingency is insufficient.",
        "The consequence change is contingent on the specified response relative to a comparator." ;
    ns1:role_bindings [ ns1:object_id <https://pmm.local/id/behavior:avoidance-response> ;
            ns1:role "target-response" ],
        [ ns1:object_id <https://pmm.local/id/contingency:avoidance-response-outcome> ;
            ns1:role "response-consequence-contingency" ],
        [ ns1:object_id <https://pmm.local/id/outcome:aversive-event> ;
            ns1:role "aversive-consequence" ] .

<https://pmm.local/id/source:ball-gunaydin-2022> a ns1:Source ;
    ns1:accessed_at "2026-08-26"^^xsd:date ;
    ns1:authority_note "Translational review of avoidance measurement and candidate neurobehavioral processes." ;
    ns1:authors "Lisa A. Gunaydin",
        "Tali M. Ball" ;
    ns1:doi "10.1038/s41386-021-01263-4" ;
