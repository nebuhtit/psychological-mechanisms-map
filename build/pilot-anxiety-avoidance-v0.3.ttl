<https://pmm.local/id/behavior:avoidance-response> a ns1:Behavior ;
    ns1:actor_scope "organism" ;
    ns1:behavior_kind "response_pattern" ;
    ns1:boundary_notes "Adaptive and maladaptive avoidance are not ontologically identical.",
