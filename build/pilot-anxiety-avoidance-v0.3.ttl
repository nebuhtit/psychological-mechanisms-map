<https://pmm.local/id/state:subjective-relief> a ns1:State ;
    ns1:bearer_scope "person" ;
    ns1:boundary_notes "Relief alone does not establish reinforcement unless later behavior increases under the contingency.",
        "Relief is a measured subjective state and cannot be inferred from objective outcome omission alone." ;
    ns1:curation_status "provisional" ;
    ns1:definition "A time-bounded experienced reduction in aversive affect or tension relative to a prior state." ;
    ns1:label "Subjective relief" ;
    ns1:ontological_level "type" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:state_kind "affective" ;
    ns1:temporal_scale "momentary" .

<https://pmm.local/id/claim:assigned-loss-probability-changes-choice> a ns1:Claim ;
    ns1:causal_assumptions [ ns1:assessment "partly_tested" ;
            ns1:consistency "Response options and monetary feedback followed the programmed probabilities." ;
            ns1:exchangeability "Stimulus assignments were counterbalanced; within-person alternatives shared the task context." ;
            ns1:interference "Participants completed individual tasks without cross-participant contingencies." ;
            ns1:positivity "Every participant encountered both action options and probabilistic outcomes." ] ;
    ns1:causal_estimand "Difference in probability of selecting the action assigned lower versus higher monetary-loss probability under counterbalanced task assignments." ;
    ns1:claim_type "causal_effect" ;
    ns1:confidence [ ns1:level "moderate" ;
            ns1:rationale "Controlled within-task probabilities and counterbalancing support a scoped causal interpretation; the sample was small and the claim does not identify the neural or psychological reinforcer." ] ;
    ns1:epistemic_status "supported" ;
    ns1:evidence_ids <https://pmm.local/id/evidence:kim-2006-avoidance-choice> ;
    ns1:exposure_id <https://pmm.local/id/contingency:avoidance-response-outcome> ;
    ns1:identification_strategy "controlled_contingency" ;
    ns1:limitations "Sixteen healthy adults provide limited population generalizability.",
        "This effect does not prove that subjective relief or medial OFC activity caused learning." ;
    ns1:outcome_id <https://pmm.local/id/behavior:avoidance-response> ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:scope [ ns1:boundary_conditions "Restricted to probabilistic monetary-loss avoidance in the cited task." ;
            ns1:context_ids <https://pmm.local/id/context:controlled-instrumental-avoidance> ;
            ns1:population "Sixteen healthy adult participants in the specified monetary instrumental task." ;
            ns1:species "human" ;
            ns1:temporal_scope "Across two sessions of repeated instrumental choices." ] ;
    ns1:statement "In the Kim et al. instrumental choice task, assigning one action a lower probability of monetary loss increased preference for that action across trials." ;
    ns1:temporal_ordering "Outcome probabilities were assigned to actions and preference developed over repeated trials." .

<https://pmm.local/id/construct:rdoc-potential-threat-anxiety> a ns1:Construct ;
    ns1:boundary_notes "Acute imminent threat belongs to a different RDoC construct.",
        "This record represents the RDoC construct, not a threat cue, context, diagnosis, or individual anxiety episode." ;
    ns1:construct_kind "neurobehavioral" ;
    ns1:curation_status "accepted" ;
    ns1:definition "A dimensional neurobehavioral construct concerning responses when harm may occur but is distant, ambiguous, or uncertain in probability." ;
    ns1:external_mappings [ ns1:accessed_at "2026-08-26"^^xsd:date ;
            ns1:external_iri "https://www.nimh.nih.gov/research/research-funded-by-nimh/rdoc/definitions-of-the-rdoc-domains-and-constructs" ;
            ns1:external_label "Potential Threat (Anxiety)" ;
            ns1:mapping_relation "close_match" ;
            ns1:mapping_status "label_verified" ;
            ns1:rationale "The official page and label are verified; RDoC does not expose a stable term IRI for this construct on the cited page." ;
            ns1:system "RDoC" ] ;
    ns1:label "RDoC Potential Threat (Anxiety) construct" ;
    ns1:ontological_level "type" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] .

<https://pmm.local/id/evidence:ball-gunaydin-maladaptive-avoidance> a ns1:Evidence ;
    ns1:causal_support "indirect" ;
    ns1:claim_ids <https://pmm.local/id/claim:anxiety-avoidance-association> ;
    ns1:design "Translational review of avoidance paradigms and candidate neurobehavioral processes." ;
    ns1:domains [ ns1:consistency "mostly_consistent" ;
            ns1:directness "partially_indirect" ;
            ns1:precision "not_reported" ;
            ns1:replication "conceptual_replication" ;
            ns1:risk_of_bias "some_concerns" ] ;
    ns1:evidence_kind "narrative_review" ;
    ns1:extraction_locator "A neurobehavioral model of maladaptive avoidance behavior and Conclusion." ;
    ns1:inference_support "association" ;
    ns1:limitations "Paradigms and clinical populations are heterogeneous." ;
    ns1:population "Human and non-human avoidance research, including clinical anxiety-related conditions." ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:source_id <https://pmm.local/id/source:ball-gunaydin-2022> ;
    ns1:species "human",
        "mixed" ;
    ns1:summary "Maladaptive avoidance is heterogeneous and may reflect threat appraisal, habitual avoidance, or trait avoidance tendency." ;
    ns1:support_direction "supports" .

<https://pmm.local/id/evidence:brown-uncertainty-anxiety> a ns1:Evidence ;
    ns1:causal_support "indirect" ;
    ns1:claim_ids <https://pmm.local/id/claim:clinical-maintenance-loop-hypothesis> ;
    ns1:design "Integrative neurocomputational and clinical review proposing an uncertainty-learning framework." ;
    ns1:domains [ ns1:consistency "mixed" ;
            ns1:directness "indirect" ;
            ns1:precision "not_reported" ;
            ns1:replication "not_assessed" ;
            ns1:risk_of_bias "some_concerns" ] ;
    ns1:evidence_kind "narrative_review" ;
    ns1:extraction_locator "Avoidance and anxiety; Integrating maladaptive aversive uncertainty learning, avoidance, and exposure therapy." ;
    ns1:inference_support "mechanism" ;
    ns1:limitations "The proposed framework is not a direct test of the complete maintenance loop." ;
    ns1:population "Adults with and without anxiety-related clinical conditions." ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:source_id <https://pmm.local/id/source:brown-2023> ;
    ns1:species "human" ;
    ns1:summary "The review proposes that uncertainty-sensitive learning and explore/exploit decisions contribute to maladaptive avoidance." ;
    ns1:support_direction "supports" .

<https://pmm.local/id/evidence:kim-2006-avoidance-choice> a ns1:Evidence ;
    ns1:causal_support "direct" ;
    ns1:claim_ids <https://pmm.local/id/claim:assigned-loss-probability-changes-choice> ;
    ns1:design "Within-participant probabilistic instrumental choice task with counterbalanced fractal assignments and reward, avoidance, and neutral conditions." ;
    ns1:domains [ ns1:consistency "single_source" ;
            ns1:directness "direct" ;
            ns1:precision "limited" ;
            ns1:replication "unreplicated" ;
            ns1:risk_of_bias "some_concerns" ] ;
    ns1:effect [ ns1:direction "positive" ;
            ns1:metric "preference for action associated with lower aversive-outcome probability" ;
            ns1:notes "Reported t(15)=1.9, one-tailed p<0.05; no confidence interval reported." ;
            ns1:value_status "reported" ] ;
    ns1:evidence_kind "controlled_experiment" ;
    ns1:extraction_locator "Materials and Methods, Stimuli and task; Results, Behavioral Results." ;
    ns1:inference_support "causal_effect" ;
    ns1:limitations "Neural activity does not establish that the measured region causally reinforced behavior.",
        "Small sample and one-tailed test." ;
    ns1:population "Sixteen healthy right-handed adults without reported neurological or psychiatric history." ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:sample_size 16 ;
    ns1:source_id <https://pmm.local/id/source:kim-2006-avoidance> ;
    ns1:species "human" ;
    ns1:summary "Participants preferentially selected the action assigned a lower probability of monetary loss over repeated trials." ;
    ns1:support_direction "supports" .

<https://pmm.local/id/evidence:krypotos-avoidance-learning-review> a ns1:Evidence ;
    ns1:causal_support "indirect" ;
    ns1:claim_ids <https://pmm.local/id/claim:negative-reinforcement-mechanism-hypothesis> ;
    ns1:design "Theoretical and empirical review of avoidance-learning models." ;
    ns1:domains [ ns1:consistency "mostly_consistent" ;
            ns1:directness "partially_indirect" ;
            ns1:precision "not_reported" ;
            ns1:replication "conceptual_replication" ;
            ns1:risk_of_bias "some_concerns" ] ;
    ns1:evidence_kind "narrative_review" ;
    ns1:extraction_locator "Principles of avoidance learning and Conclusions." ;
    ns1:inference_support "mechanism" ;
    ns1:limitations "Review-level extraction does not adjudicate every candidate mechanism." ;
    ns1:population "Human and non-human avoidance-learning research." ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:source_id <https://pmm.local/id/source:krypotos-2015> ;
    ns1:species "mixed" ;
    ns1:summary "Instrumental contingencies contribute to avoidance acquisition and maintenance, while models differ about controlling representations." ;
    ns1:support_direction "supports" .

<https://pmm.local/id/evidence:punishment-review-active-avoidance> a ns1:Evidence ;
    ns1:causal_support "indirect" ;
    ns1:claim_ids <https://pmm.local/id/claim:negative-reinforcement-mechanism-hypothesis> ;
    ns1:design "Review distinguishing response-dependent active avoidance, punishment, and Pavlovian fear." ;
    ns1:domains [ ns1:consistency "consistent" ;
            ns1:directness "partially_indirect" ;
            ns1:precision "not_reported" ;
            ns1:replication "conceptual_replication" ;
            ns1:risk_of_bias "some_concerns" ] ;
    ns1:evidence_kind "narrative_review" ;
    ns1:extraction_locator "Different forms of aversive learning, Table 1 and active-avoidance discussion." ;
    ns1:inference_support "mechanism" ;
    ns1:limitations "Review-level evidence does not identify one universal psychological representation." ;
    ns1:population "Human and non-human aversive-learning experiments." ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:source_id <https://pmm.local/id/source:punishment-mechanisms-review> ;
    ns1:species "mixed" ;
    ns1:summary "Active avoidance is an instrumental response-to-no-aversive-outcome contingency and differs from punishment and Pavlovian fear." ;
    ns1:support_direction "supports" .

<https://pmm.local/id/measurement:anxiety-multimethod> a ns1:Measurement ;
    ns1:curation_status "provisional" ;
