<https://pmm.local/id/claim:anxiety-avoidance-association> a ns1:Claim ;
    ns1:claim_type "association" ;
    ns1:confidence [ ns1:level "low" ;
            ns1:rationale "Multiple reviews support the broad association, but no pooled comparable estimate has been extracted and constructs vary." ] ;
    ns1:confounding_note "Threat severity, controllability, expected value, learning history, goals, social constraints, and measurement method can influence both variables." ;
    ns1:epistemic_status "supported" ;
    ns1:estimate [ ns1:direction "positive" ;
            ns1:metric "qualitative direction across reviews" ;
            ns1:notes "No pooled magnitude is asserted." ;
            ns1:value_status "qualitative_only" ] ;
    ns1:evidence_ids <https://pmm.local/id/evidence:ball-gunaydin-maladaptive-avoidance>,
        <https://pmm.local/id/evidence:hofmann-hay-anxiety-avoidance> ;
    ns1:exposure_id <https://pmm.local/id/state:anxiety-response> ;
    ns1:limitations "The association does not establish a universal anxiety-to-avoidance causal path." ;
    ns1:outcome_id <https://pmm.local/id/behavior:avoidance-response> ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:scope [ ns1:boundary_conditions "Anxiety may occur without avoidance and avoidance may occur without reported anxiety." ;
            ns1:context_ids <https://pmm.local/id/context:uncertain-threat> ;
            ns1:population "Human nonclinical and anxiety-related clinical samples." ;
            ns1:species "human" ;
            ns1:temporal_scope "Concurrent or short-lag association." ] ;
    ns1:statement "Anxiety-related responding and avoidance are positively associated on average, with substantial heterogeneity across tasks, people, and contexts." .

<https://pmm.local/id/claim:clinical-maintenance-loop-hypothesis> a ns1:Claim ;
    ns1:causal_assumptions [ ns1:assessment "unverified" ;
            ns1:consistency "Avoidance, objective outcome change, subjective relief, and later behavior are measured separately over time." ;
            ns1:exchangeability "Threat severity, goals, social constraints, treatment, and learning history require control or manipulation." ;
            ns1:interference "Social reinforcement and shared environments may violate no-interference assumptions." ;
            ns1:positivity "Comparable opportunities for avoidance and approach exist in the target context." ] ;
    ns1:causal_estimand "Longitudinal change in context-matched avoidance attributable to response-contingent short-term aversive reduction." ;
    ns1:claim_type "causal_hypothesis" ;
    ns1:confidence [ ns1:level "low" ;
            ns1:rationale "Components are plausible, but the complete longitudinal human pathway is not directly identified across disorders and contexts." ] ;
    ns1:epistemic_status "proposed" ;
    ns1:evidence_ids <https://pmm.local/id/evidence:brown-uncertainty-anxiety>,
        <https://pmm.local/id/evidence:hofmann-hay-anxiety-avoidance> ;
    ns1:exposure_id <https://pmm.local/id/contingency:avoidance-response-outcome> ;
    ns1:falsifiable_boundary "The pathway is weakened when measured contingent consequence change does not predict later avoidance or when contingency manipulation leaves persistence unchanged." ;
    ns1:limitations "RDoC and HiTOP alignment do not validate the causal pathway.",
        "This is not a statistical mediation claim." ;
    ns1:outcome_id <https://pmm.local/id/behavior:avoidance-response> ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:scope [ ns1:boundary_conditions "Does not apply when avoidance is adaptive or mainly controlled by other consequences." ;
            ns1:context_ids <https://pmm.local/id/context:uncertain-threat> ;
            ns1:population "Humans with persistent maladaptive anxiety-related avoidance." ;
            ns1:species "human" ;
            ns1:temporal_scope "Repeated episodes over days to years." ] ;
    ns1:statement "In some anxiety contexts, avoidance followed by short-term aversive reduction increases later avoidance and reduces opportunities for corrective learning, contributing to persistence." ;
    ns1:temporal_ordering "Avoidance precedes consequence change, which precedes later context-matched avoidance." .

<https://pmm.local/id/claim:negative-reinforcement-mechanism-hypothesis> a ns1:Claim ;
    ns1:claim_type "mechanism_hypothesis" ;
    ns1:confidence [ ns1:level "moderate" ;
            ns1:rationale "Instrumental learning is established, but the precise controlling representation differs across paradigms and stages of training." ] ;
    ns1:epistemic_status "proposed" ;
    ns1:evidence_ids <https://pmm.local/id/evidence:krypotos-avoidance-learning-review>,
        <https://pmm.local/id/evidence:punishment-review-active-avoidance> ;
    ns1:exposure_id <https://pmm.local/id/contingency:avoidance-response-outcome> ;
    ns1:falsifiable_boundary "The hypothesis is weakened where contingency manipulation does not alter later responding or where devaluation identifies a different controlling outcome." ;
    ns1:limitations "A mechanism hypothesis is not promoted to a universal causal effect." ;
    ns1:mechanism_id <https://pmm.local/id/mechanism:negative-reinforcement> ;
    ns1:outcome_id <https://pmm.local/id/behavior:avoidance-response> ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:scope [ ns1:context_ids <https://pmm.local/id/context:controlled-instrumental-avoidance> ;
            ns1:population "Human and non-human active-avoidance learners." ;
            ns1:species "mixed" ;
            ns1:temporal_scope "Across acquisition and maintenance trials." ] ;
    ns1:statement "Response-contingent aversive-outcome omission contributes to increased later avoidance through negative reinforcement learning, while safety signaling and habit may also control performance." ;
    ns1:temporal_ordering "Response-contingent consequence change follows current responding and precedes measured later response selection." .

