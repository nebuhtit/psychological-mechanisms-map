@prefix ns1: <https://pmm.local/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://pmm.local/id/claim:active-avoidance-contingency-definition> a ns1:Claim ;
    ns1:claim_type "definition" ;
    ns1:confidence [ ns1:level "not_applicable" ;
            ns1:rationale "This defines the experimental contingency and does not assert that learning or later response increase occurred." ] ;
    ns1:defined_object_id <https://pmm.local/id/contingency:avoidance-response-outcome> ;
    ns1:epistemic_status "not_assessed" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:scope [ ns1:context_ids <https://pmm.local/id/context:controlled-instrumental-avoidance> ;
            ns1:population "Human and non-human experimental subjects." ;
            ns1:species "mixed" ;
            ns1:temporal_scope "Within-trial response-consequence interval." ] ;
    ns1:source_ids <https://pmm.local/id/source:punishment-mechanisms-review> ;
    ns1:statement "In an active-avoidance contingency, a specified response changes the programmed aversive consequence relative to a comparator." .

<https://pmm.local/id/claim:rdoc-potential-threat-definition> a ns1:Claim ;
    ns1:claim_type "definition" ;
    ns1:confidence [ ns1:level "not_applicable" ;
            ns1:rationale "This is terminology provenance from the current official RDoC definition, not an empirical effect estimate." ] ;
    ns1:defined_object_id <https://pmm.local/id/construct:rdoc-potential-threat-anxiety> ;
    ns1:epistemic_status "not_assessed" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:scope [ ns1:context_ids <https://pmm.local/id/context:uncertain-threat> ;
            ns1:population "RDoC dimensional research across normal-to-abnormal human functioning." ;
            ns1:species "human" ;
            ns1:temporal_scope "Potential rather than acute imminent threat." ] ;
    ns1:source_ids <https://pmm.local/id/source:rdoc-definitions> ;
    ns1:statement "RDoC Potential Threat (Anxiety) concerns responses when harm may occur but is distant, ambiguous, or uncertain in probability." .

<https://pmm.local/id/dataset:anxiety-avoidance-pilot-v0-3> a ns1:Dataset ;
    ns1:metadata [ ns1:description "Corrected pilot separating the RDoC construct, uncertain-threat context, anxiety state, avoidance behavior, aversive outcome, outcome omission, response-outcome contingency, subjective relief, and learning mechanism." ;
            ns1:language "en" ;
            ns1:license "CC-BY-4.0" ;
            ns1:provenance [ ns1:change_note "Replaces the v0.2 pilot while preserving it as a historical snapshot." ;
                    ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
                    ns1:created_by "OpenAI Codex" ;
                    ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
                    ns1:record_version "0.3.0" ;
                    ns1:review_status "machine_validated" ;
                    ns1:source_snapshot_date "2026-08-26"^^xsd:date ] ;
            ns1:schema_path "schema/pmm-v0.3.schema.yaml" ;
            ns1:status "pilot" ;
            ns1:title "Anxiety, avoidance, and negative reinforcement pilot v0.3" ] ;
    ns1:pmm_version "0.3.4" .

<https://pmm.local/id/measurement:conditional-aversive-outcome-probability> a ns1:Measurement ;
    ns1:curation_status "accepted" ;
    ns1:definition "Estimated or programmed p(aversive outcome | response option) for each response and comparator." ;
    ns1:label "Conditional aversive-outcome probability" ;
    ns1:measurement_kind "behavioral_task" ;
    ns1:method "Report p(O|R) for every response option and any noncontingent control." ;
    ns1:ontological_level "type" ;
    ns1:provenance [ ns1:created_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:created_by "OpenAI Codex" ;
            ns1:modified_at "2026-08-26T00:00:00+03:00"^^xsd:dateTime ;
            ns1:record_version "0.3.0" ;
            ns1:review_status "machine_validated" ] ;
    ns1:result_type "continuous" ;
    ns1:target_ids <https://pmm.local/id/contingency:avoidance-response-outcome>,
        <https://pmm.local/id/outcome:aversive-event> ;
    ns1:unit_of_analysis "paradigm" .

