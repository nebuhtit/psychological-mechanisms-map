  "@graph": [
    {
      "@id": "pmm:construct:rdoc-potential-threat-anxiety",
      "@type": "Construct",
      "boundary_notes": [
        "This record represents the RDoC construct, not a threat cue, context, diagnosis, or individual anxiety episode.",
        "Acute imminent threat belongs to a different RDoC construct."
      ],
      "construct_kind": "neurobehavioral",
      "curation_status": "accepted",
      "definition": "A dimensional neurobehavioral construct concerning responses when harm may occur but is distant, ambiguous, or uncertain in probability.",
      "external_mappings": [
        {
          "accessed_at": "2026-08-26",
          "external_iri": "https://www.nimh.nih.gov/research/research-funded-by-nimh/rdoc/definitions-of-the-rdoc-domains-and-constructs",
          "external_label": "Potential Threat (Anxiety)",
          "mapping_relation": "close_match",
          "mapping_status": "label_verified",
          "rationale": "The official page and label are verified; RDoC does not expose a stable term IRI for this construct on the cited page.",
          "system": "RDoC"
        }
      ],
      "label": "RDoC Potential Threat (Anxiety) construct",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      }
    },
    {
      "@id": "pmm:context:uncertain-threat",
      "@type": "Context",
      "boundary_notes": [
        "The context is not itself anxiety and does not imply that every person responds anxiously."
      ],
      "context_kind": "composite",
      "curation_status": "accepted",
      "definition": "A context in which possible harm is temporally distant, ambiguous, or uncertain in probability.",
      "dimensions": {
        "harm_probability": "uncertain",
        "imminence": "non-imminent-or-ambiguous",
        "valence": "aversive"
      },
      "label": "Uncertain-threat context",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "scope": "Experimental or naturalistic contexts involving possible rather than acute imminent harm."
    },
    {
      "@id": "pmm:context:controlled-instrumental-avoidance",
      "@type": "Context",
      "context_kind": "experimental",
      "curation_status": "accepted",
      "definition": "An experimental context in which response-consequence probabilities are assigned or manipulated and later response selection is observed.",
      "dimensions": {
        "comparison": "alternative-response-or-noncontingent-control",
        "contingency_control": "experimenter-assigned",
        "repeated_opportunities": true
      },
      "label": "Controlled instrumental-avoidance experiment",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "scope": "Human or non-human active-avoidance and escape-learning experiments with explicit response-consequence contingencies."
    },
    {
      "@id": "pmm:state:anxiety-response",
      "@type": "State",
      "bearer_scope": "person",
      "boundary_notes": [
        "This is not a diagnosis and is not identical to the RDoC Potential Threat construct.",
        "Self-report, physiology, and behavior may dissociate."
      ],
      "curation_status": "provisional",
      "definition": "A time-bounded pattern of anxious apprehension, vigilance, arousal, or related responses in a person; no single measurement exhausts the state.",
      "label": "Anxiety response state",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "state_kind": "affective",
      "temporal_scale": "episode"
    },
    {
      "@id": "pmm:behavior:avoidance-response",
      "@type": "Behavior",
      "actor_scope": "organism",
      "behavior_kind": "response_pattern",
      "boundary_notes": [
        "Escape terminates an ongoing aversive event; avoidance prevents or reduces an anticipated event.",
        "Adaptive and maladaptive avoidance are not ontologically identical."
      ],
      "curation_status": "accepted",
      "definition": "An action or operationally identified omission that changes contact with an anticipated threat or aversive outcome; its avoidance function requires a demonstrated response-consequence relation.",
      "function_note": "Topography alone is insufficient to classify a behavior as avoidance.",
      "label": "Avoidance response",
      "observability": "operationally_inferred",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "response_topography": "Task- and context-specific action or omission."
    },
    {
      "@id": "pmm:outcome:aversive-event",
      "@type": "Outcome",
      "boundary_notes": [
        "The outcome must be operationally specified; subjective aversion and programmed valence can dissociate."
      ],
      "curation_status": "accepted",
      "definition": "A specified event whose occurrence, probability, intensity, or duration is treated as aversive in the study design or by the organism.",
      "label": "Aversive event outcome",
      "ontological_level": "type",
      "outcome_kind": "event_occurrence",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "valence": "aversive"
    },
    {
      "@id": "pmm:event:aversive-outcome-omission",
      "@type": "Event",
      "boundary_notes": [
        "Outcome omission is not identical to subjective relief or to reinforcement."
      ],
      "curation_status": "accepted",
      "definition": "Non-occurrence of an expected or programmed aversive event on a specified trial or interval.",
      "event_kind": "consequence_omission",
      "label": "Aversive-outcome omission",
      "ontological_level": "type",
      "participant_ids": [
        "pmm:outcome:aversive-event"
      ],
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "temporal_scale": "seconds"
    },
    {
      "@id": "pmm:state:subjective-relief",
      "@type": "State",
      "bearer_scope": "person",
      "boundary_notes": [
        "Relief is a measured subjective state and cannot be inferred from objective outcome omission alone.",
        "Relief alone does not establish reinforcement unless later behavior increases under the contingency."
      ],
      "curation_status": "provisional",
      "definition": "A time-bounded experienced reduction in aversive affect or tension relative to a prior state.",
      "label": "Subjective relief",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "state_kind": "affective",
      "temporal_scale": "momentary"
    },
    {
      "@id": "pmm:contingency:avoidance-response-outcome",
      "@type": "Contingency",
      "antecedent_ids": [
        "pmm:context:controlled-instrumental-avoidance"
      ],
      "boundary_notes": [
        "A programmed contingency is part of the experimental design, not by itself evidence that learning occurred."
      ],
      "comparator": "Alternative response, no response, or noncontingent/yoked consequence schedule.",
      "consequence_id": "pmm:event:aversive-outcome-omission",
      "curation_status": "accepted",
      "definition": "An n-ary dependency in which a specified response changes the probability, intensity, or duration of a specified aversive consequence relative to a comparator.",
      "label": "Avoidance response-outcome contingency",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "response_dependency": "manipulated",
      "response_id": "pmm:behavior:avoidance-response",
      "schedule": "Must be reported for each study rather than assumed universal.",
      "temporal_relation": "Response precedes consequence omission or reduction; future responding is observed on later opportunities."
    },
    {
      "@id": "pmm:mechanism:negative-reinforcement",
      "@type": "Mechanism",
      "boundary_notes": [
        "Negative denotes removal or reduction, not harmfulness.",
        "Outcome omission, relief, safety signaling, action-outcome knowledge, and habit must remain distinguishable candidate processes."
      ],
      "curation_status": "accepted",
      "definition": "Instrumental learning process in which a response-contingent removal, reduction, or prevention of an aversive consequence increases later probability or rate of the response under relevant conditions.",
      "label": "Negative reinforcement learning",
      "mechanism_kind": "learning",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
        "created_by": [
          "OpenAI Codex"
        ],
        "modified_at": "2026-08-26T00:00:00+03:00",
        "record_version": "0.3.0",
        "review_status": "machine_validated"
      },
      "realization_conditions": [
        "The consequence change is contingent on the specified response relative to a comparator.",
        "Later probability or rate of the target response increases under relevant conditions.",
        "Temporal adjacency without contingency is insufficient."
      ],
      "role_bindings": [
        {
          "object_id": "pmm:behavior:avoidance-response",
          "role": "target-response"
        },
        {
          "object_id": "pmm:contingency:avoidance-response-outcome",
          "role": "response-consequence-contingency"
        },
        {
          "object_id": "pmm:outcome:aversive-event",
          "role": "aversive-consequence"
        }
      ]
    },
    {
      "@id": "pmm:measurement:avoidance-selection-rate",
      "@type": "Measurement",
      "curation_status": "accepted",
      "definition": "Proportion or count of eligible trials on which the predefined avoidance action is selected.",
      "label": "Avoidance-action selection rate",
      "measurement_kind": "behavioral_task",
      "method": "Report the response definition, eligible trials, denominator, and contingency assigned to each option.",
      "ontological_level": "type",
      "provenance": {
        "created_at": "2026-08-26T00:00:00+03:00",
