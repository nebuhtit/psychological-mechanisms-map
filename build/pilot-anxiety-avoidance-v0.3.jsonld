      "@type": "Measurement",
      "curation_status": "accepted",
      "definition": "Estimated or programmed p(aversive outcome | response option) for each response and comparator.",
      "label": "Conditional aversive-outcome probability",
      "measurement_kind": "behavioral_task",
      "method": "Report p(O|R) for every response option and any noncontingent control.",
      "ontological_level": "type",
      "provenance": {
