      "@type": "Claim",
      "causal_assumptions": {
        "assessment": "partly_tested",
        "consistency": "Response options and monetary feedback followed the programmed probabilities.",
        "exchangeability": "Stimulus assignments were counterbalanced; within-person alternatives shared the task context.",
